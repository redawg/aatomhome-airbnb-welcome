# forest-ha / aatomhome (172.16.1.30) — copy to deploy/.env and fill secrets

HUB_PUBLIC_URL=http://172.16.1.30:8080
HUB_GUEST_URL=http://172.16.1.30:8080/guest/

DEPLOY_HOST=172.16.1.30
DEPLOY_USER=aatom
PODMAN_MODE=rootless
PROPERTY_NAME="Cielo del Oro"

ADB_TV_HUB_GIT=https://github.com/redawg/adb-tv-hub.git
ADB_TV_HUB_TAG=cdo-production-2026-09-11
ADB_TV_HUB_IMAGE=localhost/aatomhome-tv-hub:latest

# Home Assistant on same host (Supervised/OS)
HA_URL=http://127.0.0.1:8123
HA_LONG_LIVED_TOKEN=
HA_CONFIG_DIR=/home/aatom/homeassistant/config

TEMPEST_API_TOKEN=
TEMPEST_STATION_ID=

GUEST_LAUNCHER_APK=guest-launcher/releases/aatomhome-guest-welcome.apk
# Set 1 on first deploy so APK default URL matches forest-ha hub
PATCH_APK_HUB_URL=1
