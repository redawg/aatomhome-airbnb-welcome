[Unit]
Description=Aatomhome tv-hub — ADB + guest welcome (deploy from aatomhome-airbnb-welcome)
Documentation=https://github.com/redawg/aatomhome-airbnb-welcome/blob/main/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/aatomhome-tv-hub:latest
ContainerName=adb-tv-hub

Network=host

Volume=adb-tv-hub-data.volume:/data
Volume=adb-tv-hub-data.volume:/root/.android

Environment=ADB_CHECK_INTERVAL=15
Environment=ADB_RECONNECT_GRACE_SEC=60
Environment=ADB_RECONNECT_ATTEMPT_INTERVAL=300
Environment=ADB_SERVER_PORT=5037
Environment=ADB_MDNS=1
Environment=ADB_MDNS_OPENSCREEN=0
EnvironmentFile=adb-tv-hub.env

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=default.target
