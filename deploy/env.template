# Copy to deploy/.env and fill in (never commit deploy/.env)
# Quote values that contain spaces or parentheses: PROPERTY_NAME="My Property"

# --- Required: network ---
# Public URL phones/TVs use to reach the hub (no trailing slash)
# forest-ha example: http://172.16.1.30:8080
HUB_PUBLIC_URL=http://YOUR-HUB-HOST:8080
# Welcome page URL (usually HUB_PUBLIC_URL + /guest/)
HUB_GUEST_URL=http://YOUR-HUB-HOST:8080/guest/

# --- Required: deployment ---
DEPLOY_HOST=localhost
DEPLOY_USER=
PODMAN_MODE=rootless
PROPERTY_NAME="My Airbnb Property"

# --- Upstream tv-hub (frozen baseline; override only when testing) ---
ADB_TV_HUB_GIT=https://github.com/redawg/adb-tv-hub.git
ADB_TV_HUB_TAG=cdo-production-2026-09-11
ADB_TV_HUB_IMAGE=localhost/aatomhome-tv-hub:latest

# --- Home Assistant (required for HA integration + future room controls) ---
HA_URL=http://127.0.0.1:8123
HA_LONG_LIVED_TOKEN=
# Path to HA config dir containing custom_components/
HA_CONFIG_DIR=/path/to/homeassistant/config

# --- Optional: weather on welcome screen ---
TEMPEST_API_TOKEN=
TEMPEST_STATION_ID=

# --- Optional: hub API auth (future) ---
HUB_API_TOKEN=

# --- APK ---
GUEST_LAUNCHER_APK=guest-launcher/releases/aatomhome-guest-welcome.apk
# Set to 1 to patch APK default hub URL before copying into tv-hub build
PATCH_APK_HUB_URL=1
