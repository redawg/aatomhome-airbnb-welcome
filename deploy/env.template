# Copy to deploy/.env — custom / ad-hoc deploy (DEPLOY_TYPE=custom)
# Prefer: ./scripts/configure-deploy.sh --type container|homeassistant

DEPLOY_TYPE=custom
DEPLOY_PROFILE=custom

HUB_HOST=YOUR-HUB-HOST
HUB_LISTEN_PORT=8080
HUB_PUBLIC_URL=http://YOUR-HUB-HOST:8080
HUB_GUEST_URL=http://YOUR-HUB-HOST:8080/guest/

CONTAINER_DEPLOY_MODE=local
DEPLOY_HOST=
DEPLOY_USER=
PODMAN_MODE=rootless
PROPERTY_NAME="My Property"

ADB_TV_HUB_TAG=cdo-production-2026-09-11
ADB_TV_HUB_IMAGE=localhost/aatomhome-tv-hub:latest

HA_URL=http://127.0.0.1:8123
HA_LONG_LIVED_TOKEN=
HA_CONFIG_DIR=/config
HA_HOST=

TEMPEST_API_TOKEN=
TEMPEST_STATION_ID=

GUEST_LAUNCHER_APK=guest-launcher/releases/aatomhome-guest-welcome.apk
PATCH_APK_HUB_URL=1
