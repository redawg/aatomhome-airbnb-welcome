# lab-standalone — tv-hub on a lab Linux host; HA on another machine on the LAN
# Configure: ./scripts/configure-deploy.sh --profile infra3-standalone [--port 18080]
# cp deploy/profiles/infra3-standalone/env.example deploy/profiles/infra3-standalone/.env

DEPLOY_PROFILE=infra3-standalone
HUB_HOST=192.168.1.100
HUB_LISTEN_PORT=18080
HUB_PUBLIC_URL=http://192.168.1.100:18080
HUB_GUEST_URL=http://192.168.1.100:18080/guest/

DEPLOY_HOST=192.168.1.100
DEPLOY_USER=deploy
HA_HOST=192.168.1.10
HA_USER=root
HA_URL=http://192.168.1.10:8123
HA_CONFIG_DIR=/config
HA_LONG_LIVED_TOKEN=

PROPERTY_NAME="Sample Property (remote hub)"
PROPERTY_ID=1

PODMAN_MODE=rootless
REMOTE_BUILD=0

ADB_TV_HUB_TAG=cdo-production-2026-09-11
ADB_TV_HUB_IMAGE=localhost/aatomhome-tv-hub:latest

GUEST_LAUNCHER_APK=guest-launcher/releases/aatomhome-guest-welcome.apk
PATCH_APK_HUB_URL=1

TEMPEST_API_TOKEN=
TEMPEST_STATION_ID=

NETWORK_NOTES=Standalone hub — ADB requires VPN to TV LAN or use TV command agent for guest ops
