# infra3-standalone — tv-hub on fleet infra3; HA integration points at Forest HA remotely
# cp deploy/profiles/infra3-standalone/env.example deploy/profiles/infra3-standalone/.env

DEPLOY_PROFILE=infra3-standalone
HUB_PUBLIC_URL=http://172.16.1.36:8080
HUB_GUEST_URL=http://172.16.1.36:8080/guest/

# Deploy locally on infra3 (run script ON .36 or SSH as aatom)
DEPLOY_HOST=172.16.1.36
DEPLOY_USER=aatom
HA_HOST=172.16.255.250
HA_USER=root
HA_URL=http://172.16.255.250:8123
HA_CONFIG_DIR=/config
HA_LONG_LIVED_TOKEN=

PROPERTY_NAME=Forest Home (remote hub)
PROPERTY_ID=1

PODMAN_MODE=rootless
REMOTE_BUILD=0

ADB_TV_HUB_TAG=cdo-production-2026-09-11
ADB_TV_HUB_IMAGE=localhost/aatomhome-tv-hub:latest

GUEST_LAUNCHER_APK=guest-launcher/releases/aatomhome-guest-welcome.apk
PATCH_APK_HUB_URL=1

TEMPEST_API_TOKEN=
TEMPEST_STATION_ID=

NETWORK_NOTES=Standalone hub — ADB requires VPN to TV LAN or use TV command agent for guest ops
