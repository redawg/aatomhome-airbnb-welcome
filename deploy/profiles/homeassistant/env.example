# homeassistant — install HA custom integration only (HACS or manual copy)
# Configure: ./scripts/configure-deploy.sh --type homeassistant
# cp deploy/profiles/homeassistant/env.example deploy/profiles/homeassistant/.env

DEPLOY_TYPE=homeassistant
DEPLOY_PROFILE=homeassistant

# Hub URL for integration config flow (tv-hub must already be running)
HUB_HOST=192.168.1.10
HUB_LISTEN_PORT=8080
HUB_PUBLIC_URL=http://192.168.1.10:8080

PROPERTY_NAME="My Property"
PROPERTY_ID=1

# Install target — remote SSH or local HA config path
HA_HOST=
HA_USER=root
HA_CONFIG_DIR=/config
HA_URL=http://127.0.0.1:8123
HA_LONG_LIVED_TOKEN=
HA_RESTART_AFTER_INTEGRATION=1

# HACS: skip this script — add repo in HACS UI instead (see docs/HACS.md)
