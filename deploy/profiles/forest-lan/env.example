# forest-lan — tv-hub on Forest Home LAN; HA on Forest HA / Green
# cp deploy/profiles/forest-lan/env.example deploy/profiles/forest-lan/.env

DEPLOY_PROFILE=forest-lan
HUB_PUBLIC_URL=http://172.16.255.250:8080
HUB_GUEST_URL=http://172.16.255.250:8080/guest/

HA_HOST=172.16.255.250
HA_USER=root
HA_URL=http://127.0.0.1:8123
HA_CONFIG_DIR=/config
HA_LONG_LIVED_TOKEN=
HA_RESTART_AFTER_INTEGRATION=1

PROPERTY_NAME=Forest Home
PROPERTY_ID=1

PODMAN_MODE=rootful
REMOTE_BUILD=1
REMOTE_BUILD_DIR=/root/aatomhome-airbnb-welcome-build

ADB_TV_HUB_TAG=cdo-production-2026-09-11
ADB_TV_HUB_IMAGE=localhost/aatomhome-tv-hub:latest

GUEST_LAUNCHER_APK=guest-launcher/releases/aatomhome-guest-welcome.apk
PATCH_APK_HUB_URL=1

TEMPEST_API_TOKEN=
TEMPEST_STATION_ID=

# Hub DNS alias (optional) — TVs can use http://hub.forest.home:8080 if UniFi static DNS set
HUB_DNS_ALIAS=hub.forest.home
