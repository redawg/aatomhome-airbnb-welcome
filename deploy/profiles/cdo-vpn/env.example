# cdo-vpn — hub on fleet host with VPN route to CDO TV LAN (172.18.1.x)
# Do NOT point at frozen production UI on 172.18.1.137 without a maintenance plan.
# Configure: ./scripts/configure-deploy.sh --profile cdo-vpn [--port 18080]
# cp deploy/profiles/cdo-vpn/env.example deploy/profiles/cdo-vpn/.env

DEPLOY_PROFILE=cdo-vpn
HUB_HOST=172.16.1.36
HUB_LISTEN_PORT=18080
HUB_PUBLIC_URL=http://172.16.1.36:18080
HUB_GUEST_URL=http://172.16.1.36:18080/guest/

DEPLOY_HOST=172.16.1.36
DEPLOY_USER=aatom
HA_HOST=
HA_URL=
HA_CONFIG_DIR=

PROPERTY_NAME="Cielo del Oro (VPN pilot)"
PROPERTY_ID=1

PODMAN_MODE=rootless
REMOTE_BUILD=0

ADB_TV_HUB_TAG=cdo-production-2026-09-11
ADB_TV_HUB_IMAGE=localhost/aatomhome-tv-hub:latest

GUEST_LAUNCHER_APK=guest-launcher/releases/aatomhome-guest-welcome.apk
PATCH_APK_HUB_URL=1

# VPN must route 172.18.1.0/24 (or TV IPs) to this hub host for ADB
VPN_TV_SUBNET=172.18.1.0/24
CDO_PRODUCTION_FROZEN=http://172.18.1.137:8080

TEMPEST_API_TOKEN=
TEMPEST_STATION_ID=

NETWORK_NOTES=Site VPN required for hub-initiated ADB; TVs may use HUB_PUBLIC_URL if routable
