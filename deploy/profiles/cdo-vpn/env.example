# vpn-property — hub on edge host with VPN route to property TV LAN
# Configure: ./scripts/configure-deploy.sh --profile cdo-vpn [--port 18080]
# cp deploy/profiles/cdo-vpn/env.example deploy/profiles/cdo-vpn/.env

DEPLOY_PROFILE=cdo-vpn
HUB_HOST=192.168.1.100
HUB_LISTEN_PORT=18080
HUB_PUBLIC_URL=http://192.168.1.100:18080
HUB_GUEST_URL=http://192.168.1.100:18080/guest/

DEPLOY_HOST=192.168.1.100
DEPLOY_USER=deploy
HA_HOST=
HA_URL=
HA_CONFIG_DIR=

PROPERTY_NAME="Sample Property (VPN)"
PROPERTY_ID=1

PODMAN_MODE=rootless
REMOTE_BUILD=0

ADB_TV_HUB_TAG=cdo-production-2026-09-11
ADB_TV_HUB_IMAGE=localhost/aatomhome-tv-hub:latest

GUEST_LAUNCHER_APK=guest-launcher/releases/aatomhome-guest-welcome.apk
PATCH_APK_HUB_URL=1

# VPN must route property TV subnet to this hub host for ADB
VPN_TV_SUBNET=192.168.2.0/24

TEMPEST_API_TOKEN=
TEMPEST_STATION_ID=

NETWORK_NOTES=Site VPN required for hub-initiated ADB; TVs may use HUB_PUBLIC_URL if routable
