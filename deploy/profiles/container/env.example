# container — tv-hub via Podman quadlets (local host or SSH remote build)
# Configure: ./scripts/configure-deploy.sh --type container --host YOUR_HOST --port 18080
# Shared fleet hosts (e.g. infra3): use 18080 for hub HTTP; ADB = hub port + 1 (18081).
# Do not bind 8080 on multi-service hosts — other MCP stacks use it.
# cp deploy/profiles/container/env.example deploy/profiles/container/.env

DEPLOY_TYPE=container
DEPLOY_PROFILE=container

# Hub listen address (IP/hostname TVs and HA use to reach tv-hub)
HUB_HOST=192.168.1.10
HUB_LISTEN_PORT=18080
HUB_PUBLIC_URL=http://192.168.1.10:18080
HUB_GUEST_URL=http://192.168.1.10:18080/guest/
ADB_SERVER_PORT=18081

# Where to install the container: local | remote
CONTAINER_DEPLOY_MODE=local
# local: build/run on this machine (CONTAINER_DEPLOY_MODE=local)
# remote: SSH to DEPLOY_HOST, build there, install quadlets (CONTAINER_DEPLOY_MODE=remote)

DEPLOY_HOST=
DEPLOY_USER=deploy
REMOTE_BUILD=1
REMOTE_BUILD_DIR=/opt/aatomhome-airbnb-welcome-build
PODMAN_MODE=rootless

PROPERTY_NAME="My Property"
PROPERTY_ID=1

# Optional: install HA integration after container (set HA_HOST or HA_CONFIG_DIR)
HA_HOST=
HA_USER=root
HA_URL=http://127.0.0.1:8123
HA_CONFIG_DIR=/config
HA_LONG_LIVED_TOKEN=
HA_RESTART_AFTER_INTEGRATION=1

ADB_TV_HUB_TAG=cdo-production-2026-09-11
ADB_TV_HUB_IMAGE=localhost/aatomhome-tv-hub:latest

GUEST_LAUNCHER_APK=guest-launcher/releases/aatomhome-guest-welcome.apk
PATCH_APK_HUB_URL=1

TEMPEST_API_TOKEN=
TEMPEST_STATION_ID=

HUB_DNS_ALIAS=
