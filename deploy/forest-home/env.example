# Forest Home — copy to deploy/sample-property/.env (never commit .env)
# Home Assistant: http://192.168.1.10:8123 · tv-hub co-located on same host :8080

# --- Hub URLs (LAN IP TVs and phones use) ---
HUB_PUBLIC_URL=http://192.168.1.10:8080
HUB_GUEST_URL=http://192.168.1.10:8080/guest/

# --- Remote host (SSH deploy from aatomhome / workstation with root key) ---
HA_HOST=192.168.1.10
HA_USER=root
HA_SSH_OPTS=-o StrictHostKeyChecking=no -o ConnectTimeout=15

# --- Home Assistant ---
HA_URL=http://127.0.0.1:8123
HA_CONFIG_DIR=/config
# Long-lived token — vault key ha_token, or HA UI → Profile → Security
HA_LONG_LIVED_TOKEN=

PROPERTY_NAME="Forest Home"
PROPERTY_ID=1

# --- Build / deploy ---
PODMAN_MODE=rootful
ADB_TV_HUB_GIT=https://github.com/redawg/adb-tv-hub.git
ADB_TV_HUB_TAG=cdo-production-2026-09-11
ADB_TV_HUB_IMAGE=localhost/aatomhome-tv-hub:latest
REMOTE_BUILD=1

# --- APK (patch default hub URL to Forest Home) ---
GUEST_LAUNCHER_APK=guest-launcher/releases/aatomhome-guest-welcome.apk
PATCH_APK_HUB_URL=1

# --- Optional weather on welcome screen ---
TEMPEST_API_TOKEN=
TEMPEST_STATION_ID=

# --- After integration copy: restart HA core (1) or skip (0) ---
HA_RESTART_AFTER_INTEGRATION=1
